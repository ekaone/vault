{
  "name": "@ekaone/vault",
  "version": "0.0.2",
  "description": "Encrypted, ephemeral, runtime-agnostic key-value store with TTL",
  "keywords": [
    "vault",
    "secrets",
    "encrypted",
    "in-memory",
    "ttl",
    "aes-gcm",
    "web-crypto",
    "security"
  ],
  "author": "ekaone",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ekaone/vault"
  },
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm typecheck && pnpm clean && pnpm tsup",
    "dev": "tsx src/cli.ts",
    "watch": "tsup --watch",
    "clean": "rimraf dist",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "pnpm run clean && pnpm run test && pnpm run build",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "@types/node": "^25.5.0",
    "@vitest/coverage-v8": "^4.1.0",
    "@vitest/ui": "^4.1.0",
    "rimraf": "^6.1.3",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.1.0"
  }
}
